# Control NGR - servidor web del frontend
# Sirve la aplicacion Angular y reenvia /api e /img al backend (que no se publica fuera de Docker).

server_tokens off;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Evidencias de hasta 10 MB (el backend valida el limite real)
    client_max_body_size 12m;

    # ---------- API ----------
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Se reemplaza (no se agrega) para que el cliente no pueda falsificar su IP
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ---------- Fotos de perfil ----------
    location /img/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        expires 1d;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ---------- Archivos estaticos con hash: cache larga ----------
    location ~* \.(?:js|css|woff2?|ttf|svg|png|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # ---------- Aplicacion (rutas de Angular) ----------
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
