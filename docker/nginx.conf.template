# Control NGR - servidor web del frontend
# Sirve la aplicacion Angular por HTTPS y reenvia /api e /img al backend (que no se publica fuera de Docker).
# HTTPS es obligatorio: los navegadores solo permiten usar la camara (reconocimiento facial) en paginas seguras.

server_tokens off;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;

# HTTP solo redirige a HTTPS
server {
    listen 80;
    server_name _;
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/servidor.crt;
    ssl_certificate_key /etc/nginx/certs/servidor.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:5m;
    ssl_session_timeout 1h;

    root /usr/share/nginx/html;
    index index.html;

    # Evidencias de hasta 10 MB (el backend valida el limite real)
    client_max_body_size 12m;

    # ---------- API ----------
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # Se reemplaza (no se agrega) para que el cliente no pueda falsificar su IP
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ---------- Fotos de perfil ----------
    # ^~ evita que la regla de archivos estaticos (.png) de abajo capture las fotos
    location ^~ /img/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $http_host;
        expires 1d;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ---------- Archivos estaticos con hash: cache larga ----------
    location ~* \.(?:js|css|woff2?|ttf|svg|png|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # ---------- Aplicacion (rutas de Angular) ----------
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
